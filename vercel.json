{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/send",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
